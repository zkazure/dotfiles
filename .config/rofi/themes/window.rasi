/**
 * Kazure's Unified Theme - Window Mode
 */
@import "base.rasi"

configuration {
    font:             "Maple Mono NF CN 11";
    icon-theme:       "Reversal-dark";
    show-icons:       true;
    monitor:          -4;
}

window {
    width:            1000px;
}

listview {
    columns:          1;
    layout:           vertical;
}

element {
    orientation:      horizontal;
}

